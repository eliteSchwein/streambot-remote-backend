APP_BIND=0.0.0.0:8080
APP_PUBLIC_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgres://streambot:streambot@postgres:5432/streambot_remote
VALKEY_URL=redis://valkey:6379/
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
SESSION_COOKIE_NAME=streambot_remote_session
SESSION_TTL_SECONDS=604800
RUST_LOG=streambot_remote_backend=debug,tower_http=info

# Webcam streaming via MediaMTX
# Shared secret for the MediaMTX -> backend auth hook. Keep it URL-safe: openssl rand -hex 32
MEDIAMTX_AUTH_SECRET=
MEDIAMTX_API_URL=http://mediamtx:9997
# Public hostname/IP of the MediaMTX server. All client URLs are built from it
# plus the ports below: srt://HOST:SRT_PORT (bots), http://HOST:WEBRTC_PORT
# (WHEP, browsers), rtsp://HOST:RTSP_PORT (read-only viewers).
MEDIAMTX_HOST=localhost
# Ports: used by docker-compose (published = listening port) and the backend.
MEDIAMTX_SRT_PORT=18890
MEDIAMTX_WEBRTC_PORT=18889
MEDIAMTX_WEBRTC_UDP_PORT=18189
MEDIAMTX_RTSP_PORT=18554
# Optional overrides: WHEP base behind an HTTPS reverse proxy (needed when the
# frontend is served over https), and a separate SRT ingest host.
#MEDIAMTX_PUBLIC_URL=https://live.example.com
#MEDIAMTX_SRT_HOST=ingest.example.com
# Only used by docker compose for the mediamtx service (comma separated public IPs/hosts for ICE)
MEDIAMTX_WEBRTC_ADDITIONAL_HOSTS=127.0.0.1
